{
  "name": "@stash/daemon",
  "version": "0.2.4",
  "private": true,
  "description": "Stash local-first daemon (Go). Packaging only: the build script embeds the built viewer.",
  "scripts": {
    "build": "sh scripts/build.sh",
    "clean": "git clean -fqX internal/viewer/dist",
    "test": "sh scripts/ensure-viewer-dist.sh && go test ./... -race",
    "lint": "sh scripts/ensure-viewer-dist.sh && go vet ./...",
    "format": "gofmt -w cmd internal",
    "tscheck": "sh scripts/ensure-viewer-dist.sh && go vet ./..."
  },
  "dependencies": {
    "stash-viewer": "workspace:*"
  }
}
