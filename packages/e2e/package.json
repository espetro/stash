{
  "name": "@stash/e2e",
  "version": "0.9.0",
  "type": "module",
  "description": "E2E tests for Stash browser extension and viewer using Playwright + markdown loader",
  "scripts": {
    "test": "playwright test",
    "test:spec": "playwright test --grep",
    "test:smoke": "playwright test --grep @smoke",
    "test:extension": "playwright test --grep-invert 'no extension'",
    "test:viewer": "playwright test viewer-rendering",
    "test:e2e": "playwright test end-to-end-integration",
    "test:link": "playwright test extension-link-generation",
    "test:ui": "playwright test --ui",
    "test:browseros": "BROWSER_LABEL=browseros playwright test --grep runtime",
    "test:browseros:openrouter": "BROWSER_LABEL=browseros BROWSEROS_OPENROUTER=1 playwright test --grep runtime",
    "test:chrome": "BROWSER_LABEL=chrome playwright test --grep runtime",
    "tscheck": "tsc --noEmit",
    "lint": "oxlint --fix step_implementations helpers lib specs.spec.ts",
    "format": "oxfmt --write 'step_implementations/**/*.ts' 'helpers/**/*.ts' 'lib/**/*.ts' 'specs.spec.ts'",
    "validate:steps": "tsx lib/dry-run.ts",
    "validate": "tsx ../../scripts/validate.ts --cwd packages/e2e"
  },
  "dependencies": {
    "@stash/codec": "workspace:*",
    "brotli-wasm": "^3.0.1",
    "playwright": "^1.62.1"
  },
  "devDependencies": {
    "@playwright/test": "^1.62.1",
    "@types/chrome": "^0.2.6",
    "@types/node": "^24.12.4",
    "dotenv": "^17.4.2",
    "typescript": "^7.0.2"
  }
}