{
  "name": "@stash/mcp-relay",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Stdio-JSON-RPC relay that bridges desktop MCP clients (Claude Desktop, Cursor) to the stash browser extension's local MCP server.",
  "bin": {
    "stash-mcp-relay": "./dist/cli.js"
  },
  "scripts": {
    "clean": "rm -rf dist",
    "build": "tsc -p tsconfig.build.json",
    "tscheck": "tsc --noEmit",
    "test": "vitest run",
    "format": "oxfmt --write 'src/**/*.ts' '__tests__/**/*.ts'",
    "lint": "oxlint --fix src __tests__"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.30.0",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@types/node": "^24.12.4",
    "typescript": "^7.0.2",
    "vitest": "^4.1.7"
  }
}
