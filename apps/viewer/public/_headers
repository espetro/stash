# Cache control for static assets
/_astro/*.css
  Cache-Control: public, max-age=31536000, immutable

/_astro/*.js
  Cache-Control: public, max-age=31536000, immutable

# Default headers for static files
/favicon.svg
  Cache-Control: public, max-age=86400

# Root-level images are not content-hashed, so a year-long immutable
# cache strands updates at the edge (this already bit icon-*.png once —
# renamed assets must use a -vN suffix to bust stale copies).
/*.png
  Cache-Control: public, max-age=86400

/*.jpg
  Cache-Control: public, max-age=86400

/*.ico
  Cache-Control: public, max-age=86400

# Agent-discovery link headers on the homepage
# (llms.txt, hosted MCP server card, OpenAPI spec)
/
  Link: <https://stash.illo.fyi/llms.txt>; rel="llms", <https://stash.illo.fyi/.well-known/mcp-server-card.json>; rel="service", <https://stash.illo.fyi/openapi.json>; rel="describedby"

# /stashes library page: alternate discovery for agent exports.
# (/s needs no rule — functions/s.ts emits rel="alternate" Link headers
# itself on every fallthrough response.)
/stashes/
  Link: <https://stash.illo.fyi/stashes/?agent=json>; rel="alternate"; type="application/json", <https://stash.illo.fyi/stashes/?agent=markdown>; rel="alternate"; type="text/markdown"
