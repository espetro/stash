{
  "name": "stash-viewer",
  "version": "0.8.1",
  "private": true,
  "description": "Stash viewer site",
  "type": "module",
  "scripts": {
    "clean": "rm -rf dist",
    "dev": "astro dev",
    "build": "astro build",
    "sync": "astro sync",
    "i18n:fill": "INTL_AI_FILL=1 intl-ai fill --config $(pwd)/intl-ai.config.ts",
    "preview": "astro preview",
    "format": "oxfmt --write 'src/**/*.{ts,tsx}' && prettier --write 'src/**/*.astro' --plugin prettier-plugin-astro --ignore-path .prettierignore",
    "lint": "oxlint src --ignore-pattern '**/*.d.ts'",
    "tscheck": "astro sync && tsc --noEmit",
    "test": "vitest run",
    "test:dist": "vitest run src/__tests__/dist-alternates.test.ts"
  },
  "dependencies": {
    "@astrojs/react": "^5.0.4",
    "@astrojs/sitemap": "^3.7.3",
    "@astrojs/starlight": "^0.39.2",
    "@msgpack/msgpack": "^3.1.3",
    "@stash/codec": "workspace:*",
    "@stash/shared": "workspace:*",
    "@stash/theme": "workspace:*",
    "astro": "^6.3.1",
    "brotli-wasm": "^3.0.1",
    "geist": "^1.7.0",
    "intl-messageformat": "^11.2.8",
    "lean-qr": "^2.7.1",
    "markdown-escape": "^2.0.0",
    "neverthrow": "8.2.0",
    "pako": "^2.1.0",
    "radix-ui": "^1.4.3",
    "react": "^19.2.6",
    "react-dom": "^19.2.6",
    "react-icons": "^5.6.0",
    "vaul": "^1.1.2"
  },
  "devDependencies": {
    "@ai-sdk/openai-compatible": "^2.0.51",
    "@cloudflare/workers-types": "^4.20260526.1",
    "@intl-ai/api": "0.4.1",
    "@intl-ai/cli": "0.3.2",
    "@intl-ai/unplugin": "0.4.1",
    "@tailwindcss/postcss": "^4.3.0",
    "@tailwindcss/vite": "^4.3.0",
    "@testing-library/react": "^16.3.2",
    "@types/node": "^24.12.3",
    "@types/pako": "^2.0.4",
    "@types/react": "^19.2.14",
    "@types/react-dom": "^19.2.3",
    "babel-plugin-react-compiler": "^1.0.0",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "happy-dom": "^20.9.0",
    "postcss": "^8.5.15",
    "prettier": "^3.8.3",
    "prettier-plugin-astro": "^0.14.1",
    "tailwind-merge": "^3.6.0",
    "tailwindcss": "^4.3.0",
    "tw-animate-css": "^1.4.0",
    "typescript": "^7.0.2",
    "vitest": "^3.0.0"
  }
}