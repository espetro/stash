---
import ViewerLayout from "../layouts/ViewerLayout.astro";
import TabViewer from "../components/TabViewer";
---

<!--
  Agent notice: this page decodes its payload client-side from the URL
  fragment (#p=...), which is invisible to servers. To fetch the contents
  server-side, pass the payload as a query parameter and negotiate the
  format:
    GET /s?p=<payload>  with Accept: application/json | text/markdown | text/plain
                        (canonical), or ?format=json|md|txt (fallback)
  Without negotiation it serves this interactive HTML viewer.
-->
<ViewerLayout title="Stash Viewer">
  <TabViewer client:only="react" />
</ViewerLayout>
