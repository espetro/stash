---
import Layout from "@/layouts/Layout.astro";
import LandingPage from "@/components/landing/LandingPage.astro";
import { isLang, DEFAULT_LANG, type Lang } from "@/i18n";

const raw = Astro.currentLocale ?? DEFAULT_LANG;
const lang: Lang = isLang(raw) ? raw : DEFAULT_LANG;
---

<Layout
  title="Stash — Твои вкладки — это твоё мышление."
  lang={lang}
  localizedPath="/ru"
>
  <LandingPage lang={lang} />
</Layout>
