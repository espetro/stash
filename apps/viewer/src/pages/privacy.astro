---
import Layout from "@/layouts/Layout.astro";
import Navbar from "@/components/landing/Navbar";
import Footer from "@/components/landing/Footer.astro";
import { LuBadgeCheck } from "react-icons/lu";
---

<Layout title="Privacy Policy — Stash">
  <Navbar minimal={true} client:load />
  <main class="page-main dark">
    <div class="page-container">
      <!-- Page header -->
      <header class="page-header">
        <span class="page-label">PRIVACY POLICY</span>
        <h1 class="page-title">Privacy-First by Design</h1>
        <p class="page-subtitle">
          Stash is local-first: your tabs stay on your device unless you choose
          to create a shareable link. Here's exactly what happens — and what
          doesn't.
        </p>
      </header>

      <!-- At a glance -->
      <ul class="policy-list" role="list">
        <li class="policy-item">
          <LuBadgeCheck className="size-[18px] flex-shrink-0 mt-[3px]" />
          <div>
            <strong>No personal data is collected.</strong> We collect anonymous aggregate
            counters only (e.g. how often a feature is used) — never URLs, titles,
            tags, notes, or any identifier tied to you.
          </div>
        </li>
        <li class="policy-item">
          <LuBadgeCheck className="size-[18px] flex-shrink-0 mt-[3px]" />
          <div>
            <strong>All sharing happens locally in your browser.</strong> Stash selection
            and link generation occur entirely on your device.
          </div>
        </li>
        <li class="policy-item">
          <LuBadgeCheck className="size-[18px] flex-shrink-0 mt-[3px]" />
          <div>
            <strong>Default share links contain data only in the URL.</strong>
            Tab URLs and titles are compressed and encoded into the link itself and
            decoded in the visitor's browser; our servers never see them.
          </div>
        </li>
        <li class="policy-item">
          <LuBadgeCheck className="size-[18px] flex-shrink-0 mt-[3px]" />
          <div>
            <strong
              >Short links are stored server-side only when you choose that
              mode.</strong
            > Entries can be client-encrypted (zero-trust): the decryption key lives
            only in the link's fragment and never reaches our servers. Entries expire
            automatically and are deleted.
          </div>
        </li>
        <li class="policy-item">
          <LuBadgeCheck className="size-[18px] flex-shrink-0 mt-[3px]" />
          <div>
            <strong>The browser extension only sends anonymous counters.</strong
            > The Chrome and Firefox extensions run entirely on your device: snapshots
            are encoded locally and preferences are stored in local browser storage.
            The only network calls for telemetry are small, opt-out event names (e.g.
            "stash saved") — never tab URLs, titles, tags, notes, or an identifier
            tied to you.
          </div>
        </li>
        <li class="policy-item">
          <LuBadgeCheck className="size-[18px] flex-shrink-0 mt-[3px]" />
          <div>
            <strong
              >This website uses PostHog (cookieless) for analytics.</strong
            >
            We collect anonymous page views, clicks, and a small set of feature-usage
            event names only — no cookies, no persistent identifiers, no tab content.
          </div>
        </li>
      </ul>

      <!-- Formal policy -->
      <span class="page-label">THE POLICY</span>
      <div class="terms-body">
        <section class="term-section">
          <h2 class="term-heading">1. Who operates Stash</h2>
          <p class="term-body">
            Stash is an open-source project maintained by Joaquin Terrasa (<a
              href="https://github.com/espetro"
              target="_blank"
              rel="noopener noreferrer"
              class="inline-link">@espetro</a
            >). For any privacy question or request, email
            <a href="mailto:josocjoq+dev@pm.me" class="inline-link"
              >josocjoq+dev@pm.me</a
            >
            or open an issue in the
            <a
              href="https://github.com/espetro/stash/issues"
              target="_blank"
              rel="noopener noreferrer"
              class="inline-link">GitHub repository</a
            >.
          </p>
        </section>

        <section class="term-section">
          <h2 class="term-heading">2. Data we process</h2>
          <p class="term-body">
            <strong>Website (stash.illo.fyi).</strong> Anonymous page views, clicks,
            and feature-usage event names via PostHog's cookieless mode. No cookies,
            no persistent identifiers, and URL fragments (which can carry shared stash
            content) are never captured.
          </p>
          <p class="term-body">
            <strong>Browser extension.</strong> Tab snapshots, names, tags, and preferences
            are stored in your browser's local storage and processed on your device.
            The only outbound calls are anonymous, aggregate usage counters — sent
            only when telemetry is enabled (on by default, switchable in the extension's
            settings).
          </p>
          <p class="term-body">
            <strong>Tab URLs and titles.</strong> Local by default. They leave your
            device only when you explicitly create a share link — and only in the
            form that link requires.
          </p>
        </section>

        <section class="term-section">
          <h2 class="term-heading">3. Share links and the relay</h2>
          <p class="term-body">
            Stash offers two link types. <strong>Self-contained links</strong>
            carry the compressed payload inside the URL fragment (<code
              >#p=…</code
            >); nothing is stored on our servers and the fragment is never sent
            in HTTP requests. <strong>Short links</strong> store an entry on our Cloudflare-hosted
            relay under an unguessable random 6-character id. A stored entry contains
            only the payload — plaintext-encoded or client-encrypted ciphertext (zero-trust
            mode, where the key exists solely in the link's <code
              >#&lt;key&gt;</code
            > fragment and never reaches the server) — plus creation and expiry timestamps.
            No account, IP profile, or user identifier is attached.
          </p>
        </section>

        <section class="term-section">
          <h2 class="term-heading">4. Anonymous analytics</h2>
          <p class="term-body">
            Both the website and the extension report anonymous aggregate event
            names (e.g. "stash saved", page views) to PostHog, hosted in the EU.
            We use these counters to understand feature usage. They contain no
            URLs, titles, notes, or identifiers. You can turn telemetry off in
            the extension's settings; the site's analytics use cookieless,
            memory-only persistence.
          </p>
        </section>

        <section class="term-section">
          <h2 class="term-heading">5. Google OAuth and the Chrome Web Store</h2>
          <p class="term-body">
            The project operates a Google OAuth app named "Stash" that is used
            exclusively by the maintainer's release automation (GitHub Actions)
            to upload and publish extension packages via the Chrome Web Store
            API. This is maintainer-only automation: it never requests access to
            end-user Google data, and Stash never asks users to connect a Google
            account.
          </p>
        </section>

        <section class="term-section">
          <h2 class="term-heading">6. Local daemon and native messaging</h2>
          <p class="term-body">
            The optional Stash daemon communicates with the browser extension
            over native messaging. All of that traffic stays on your machine;
            nothing is relayed to our servers.
          </p>
        </section>

        <section class="term-section">
          <h2 class="term-heading">7. Retention and deletion</h2>
          <p class="term-body">
            Local data (saved stashes, preferences) stays on your device until
            you delete it. Short-link entries expire automatically at the link's
            chosen lifetime and are deleted on expiry; you can also revoke a
            short link early through the relay's deletion endpoint. We retain no
            personal data because we collect none.
          </p>
        </section>

        <section class="term-section">
          <h2 class="term-heading">8. No sale, no advertising</h2>
          <p class="term-body">
            We do not sell data, share it with advertisers, or use it for
            advertising or profiling.
          </p>
        </section>

        <section class="term-section">
          <h2 class="term-heading">9. Your choices</h2>
          <p class="term-body">
            Sharing is always explicit: nothing is transmitted until you create
            a link. You can use self-contained links to avoid server storage
            entirely, disable telemetry in the extension settings, and revoke
            short links before they expire.
          </p>
        </section>

        <section class="term-section">
          <h2 class="term-heading">10. Changes and contact</h2>
          <p class="term-body">
            If this policy changes, the updated version is posted on this page.
            Effective date: October 7, 2026. Contact:
            <a href="mailto:josocjoq+dev@pm.me" class="inline-link"
              >josocjoq+dev@pm.me</a
            >.
          </p>
        </section>
      </div>

      <!-- Footer note -->
      <div class="page-foot">
        <a href="/" class="back-link">← Back to home</a>
        <span class="updated">Last updated: October 2026</span>
      </div>
    </div>
  </main>
  <Footer />
</Layout>

<style>
  .page-main {
    background-color: var(--background);
    min-height: 100vh;
    padding-top: 5rem; /* navbar offset */
  }

  .page-container {
    max-width: 44rem;
    margin: 0 auto;
    padding: 4rem 1.5rem 5rem;
  }

  /* Header */
  .page-header {
    margin-bottom: 3rem;
    padding-bottom: 2.5rem;
    border-bottom: 1px solid var(--border);
  }

  .page-label {
    display: block;
    font-family: var(--font-mono);
    font-size: 0.6875rem;
    text-transform: uppercase;
    letter-spacing: 0.1em;
    color: var(--muted-foreground);
    margin-bottom: 1rem;
  }

  .page-title {
    font-size: 2rem;
    font-weight: 700;
    letter-spacing: -0.03em;
    color: var(--foreground);
    margin: 0 0 0.875rem;
    line-height: 1.1;
  }

  .page-subtitle {
    font-size: 1rem;
    line-height: 1.6;
    color: var(--muted-foreground);
    margin: 0;
    max-width: 36rem;
  }

  /* Policy list */
  .policy-list {
    list-style: none;
    padding: 0;
    margin: 0 0 3rem;
  }

  .policy-item {
    display: flex;
    align-items: flex-start;
    gap: 0.875rem;
    padding: 1.125rem 0;
    border-bottom: 1px solid var(--border);
    font-size: 0.9375rem;
    color: var(--foreground);
    line-height: 1.6;
  }

  .policy-item:first-child {
    border-top: none;
  }

  .policy-item:last-child {
    border-bottom: none;
  }

  /* Formal sections (same rhythm as /terms) */
  .terms-body {
    margin-bottom: 3rem;
    margin-top: 1rem;
  }

  .term-section {
    padding: 1.5rem 0;
    border-bottom: 1px solid var(--border);
  }

  .term-section:first-child {
    padding-top: 0;
  }

  .term-section:last-child {
    border-bottom: none;
    padding-bottom: 0;
  }

  .term-heading {
    font-size: 1rem;
    font-weight: 600;
    color: var(--foreground);
    margin: 0 0 0.625rem;
    letter-spacing: -0.01em;
  }

  .term-body {
    font-size: 0.9375rem;
    color: var(--muted-foreground);
    line-height: 1.7;
    margin: 0;
  }

  .term-body + .term-body {
    margin-top: 0.75rem;
  }

  .term-body code {
    font-family: var(--font-mono);
    font-size: 0.8125rem;
  }

  .inline-link {
    color: var(--primary);
    text-decoration: none;
    border-bottom: 1px solid transparent;
    transition: border-color 0.15s ease;
  }

  .inline-link:hover {
    border-bottom-color: var(--primary);
  }

  /* Footer row */
  .page-foot {
    padding-top: 2rem;
    border-top: 1px solid var(--border);
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 1rem;
    flex-wrap: wrap;
  }

  .back-link {
    font-size: 0.9375rem;
    font-weight: 500;
    color: var(--primary);
    text-decoration: none;
    transition: opacity 0.15s ease;
  }

  .back-link:hover {
    opacity: 0.8;
  }

  .back-link:focus-visible {
    outline: 2px solid var(--ring);
    outline-offset: 2px;
    border-radius: 2px;
  }

  .updated {
    font-family: var(--font-mono);
    font-size: 0.75rem;
    color: var(--muted-foreground);
  }

  @media (min-width: 768px) {
    .page-container {
      padding-top: 5rem;
      padding-bottom: 6rem;
    }

    .page-title {
      font-size: 2.5rem;
    }
  }
</style>
