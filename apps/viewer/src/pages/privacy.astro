---
import Layout from "@/layouts/Layout.astro";
import Navbar from "@/components/landing/Navbar";
import Footer from "@/components/landing/Footer.astro";
import { LuBadgeCheck } from "react-icons/lu";
---

<Layout title="Privacy Policy — Stash">
  <Navbar minimal={true} client:load />
  <main class="page-main dark">
    <div class="page-container">
      <!-- Page header -->
      <header class="page-header">
        <span class="page-label">PRIVACY POLICY</span>
        <h1 class="page-title">Privacy-First by Design</h1>
        <p class="page-subtitle">
          Stash is local-first: your tabs stay on your device unless you choose
          to create a shareable link. Here's exactly what happens — and what
          doesn't.
        </p>
      </header>

      <!-- Policy items -->
      <ul class="policy-list" role="list">
        <li class="policy-item">
          <LuBadgeCheck className="size-[18px] flex-shrink-0 mt-[3px]" />
          <div>
            <strong>No personal data is collected.</strong> We don't track you, store
            cookies, or gather any information about you.
          </div>
        </li>
        <li class="policy-item">
          <LuBadgeCheck className="size-[18px] flex-shrink-0 mt-[3px]" />
          <div>
            <strong>All sharing happens locally in your browser.</strong> Stash selection
            and link generation occur entirely on your device.
          </div>
        </li>
        <li class="policy-item">
          <LuBadgeCheck className="size-[18px] flex-shrink-0 mt-[3px]" />
          <div>
            <strong>Default share links contain data only in the URL.</strong>
            Tab URLs and titles are compressed and encoded into the link itself and
            decoded in the visitor's browser; our servers never see them.
          </div>
        </li>
        <li class="policy-item">
          <LuBadgeCheck className="size-[18px] flex-shrink-0 mt-[3px]" />
          <div>
            <strong
              >Short links are stored server-side only when you choose that
              mode.</strong
            > The tab URLs and titles you selected are stored encrypted-in-transit
            in Cloudflare KV under a random id, never linked to you, and deleted automatically
            when the link expires (1–30 days).
          </div>
        </li>
        <li class="policy-item">
          <LuBadgeCheck className="size-[18px] flex-shrink-0 mt-[3px]" />
          <div>
            <strong>Links expire automatically.</strong> Shared content cannot be
            accessed once a link expires.
          </div>
        </li>
        <li class="policy-item">
          <LuBadgeCheck className="size-[18px] flex-shrink-0 mt-[3px]" />
          <div>
            <strong>The browser extension collects nothing.</strong> The Chrome and
            Firefox extensions run entirely on your device: snapshots are encoded
            locally and preferences are stored in local browser storage. No analytics
            run inside the extension.
          </div>
        </li>
        <li class="policy-item">
          <LuBadgeCheck className="size-[18px] flex-shrink-0 mt-[3px]" />
          <div>
            <strong
              >This website uses PostHog (cookieless) for analytics.</strong
            >
            We collect anonymous page views and clicks only—no cookies, no persistent
            identifiers, no tab content.
          </div>
        </li>
      </ul>

      <!-- Footer note -->
      <div class="page-foot">
        <a href="/" class="back-link">← Back to home</a>
        <span class="updated">Last updated: 2026</span>
      </div>
    </div>
  </main>
  <Footer />
</Layout>

<style>
  .page-main {
    background-color: var(--background);
    min-height: 100vh;
    padding-top: 5rem; /* navbar offset */
  }

  .page-container {
    max-width: 44rem;
    margin: 0 auto;
    padding: 4rem 1.5rem 5rem;
  }

  /* Header */
  .page-header {
    margin-bottom: 3rem;
    padding-bottom: 2.5rem;
    border-bottom: 1px solid var(--border);
  }

  .page-label {
    display: block;
    font-family: var(--font-mono);
    font-size: 0.6875rem;
    text-transform: uppercase;
    letter-spacing: 0.1em;
    color: var(--muted-foreground);
    margin-bottom: 1rem;
  }

  .page-title {
    font-size: 2rem;
    font-weight: 700;
    letter-spacing: -0.03em;
    color: var(--foreground);
    margin: 0 0 0.875rem;
    line-height: 1.1;
  }

  .page-subtitle {
    font-size: 1rem;
    line-height: 1.6;
    color: var(--muted-foreground);
    margin: 0;
    max-width: 36rem;
  }

  /* Policy list */
  .policy-list {
    list-style: none;
    padding: 0;
    margin: 0 0 3rem;
  }

  .policy-item {
    display: flex;
    align-items: flex-start;
    gap: 0.875rem;
    padding: 1.125rem 0;
    border-bottom: 1px solid var(--border);
    font-size: 0.9375rem;
    color: var(--foreground);
    line-height: 1.6;
  }

  .policy-item:first-child {
    border-top: none;
  }

  .policy-item:last-child {
    border-bottom: none;
  }

  .check-icon {
    flex-shrink: 0;
    margin-top: 0.1875rem;
  }

  /* Footer row */
  .page-foot {
    padding-top: 2rem;
    border-top: 1px solid var(--border);
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 1rem;
    flex-wrap: wrap;
  }

  .back-link {
    font-size: 0.9375rem;
    font-weight: 500;
    color: var(--primary);
    text-decoration: none;
    transition: opacity 0.15s ease;
  }

  .back-link:hover {
    opacity: 0.8;
  }

  .back-link:focus-visible {
    outline: 2px solid var(--ring);
    outline-offset: 2px;
    border-radius: 2px;
  }

  .updated {
    font-family: var(--font-mono);
    font-size: 0.75rem;
    color: var(--muted-foreground);
  }

  @media (min-width: 768px) {
    .page-container {
      padding-top: 5rem;
      padding-bottom: 6rem;
    }

    .page-title {
      font-size: 2.5rem;
    }
  }
</style>
