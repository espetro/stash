---
import Layout from "@/layouts/Layout.astro";
import LandingPage from "@/components/landing/LandingPage.astro";
import { isLang, DEFAULT_LANG, t } from "@/i18n";

const raw = Astro.currentLocale ?? DEFAULT_LANG;
const lang = isLang(raw) ? raw : DEFAULT_LANG;
---

<Layout
  title="Stash — Your tabs are your thinking."
  description={t("meta.description", undefined, lang)}
  lang={lang}
  localizedPath="/"
>
  <LandingPage lang={lang} />
</Layout>
