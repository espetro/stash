---
import { t, DEFAULT_LANG, type Lang } from "@/i18n";

interface Props {
  /**
   * Server-resolved locale. Optional so unprefixed pages
   * (`/privacy`, `/terms`) keep working without changes.
   */
  lang?: Lang;
}
const lang: Lang = Astro.props.lang ?? DEFAULT_LANG;
---

<footer class="footer bg-background border-t border-border">
  <div
    class="footer-inner max-w-7xl mx-auto py-5 px-6 grid items-center gap-6"
    style="grid-template-columns: 1fr 1fr"
  >
    <span class="footer-copy font-mono text-xs text-muted-foreground"
      >{t("footer.copyright", undefined, lang)}
      <span class="opacity-60 ml-1">v{import.meta.env.APP_VERSION}</span></span
    >

    <nav class="flex items-center justify-end gap-6" aria-label="Footer links">
      <a
        href="https://github.com/espetro/stash"
        class="footer-link font-mono text-xs text-muted-foreground no-underline transition-colors duration-150 hover:text-foreground focus-visible:outline focus-visible:outline-ring focus-visible:outline-offset-2 focus-visible:rounded-sm"
        target="_blank"
        rel="noopener noreferrer">{t("footer.github", undefined, lang)}</a
      >
      <a
        href="/privacy"
        class="footer-link font-mono text-xs text-muted-foreground no-underline transition-colors duration-150 hover:text-foreground focus-visible:outline focus-visible:outline-ring focus-visible:outline-offset-2 focus-visible:rounded-sm"
        >{t("footer.privacy", undefined, lang)}</a
      >
      <a
        href="/terms"
        class="footer-link font-mono text-xs text-muted-foreground no-underline transition-colors duration-150 hover:text-foreground focus-visible:outline focus-visible:outline-ring focus-visible:outline-offset-2 focus-visible:rounded-sm"
        >{t("footer.terms", undefined, lang)}</a
      >
    </nav>
  </div>
</footer>

<style>
  @media (max-width: 640px) {
    .footer-inner {
      grid-template-columns: 1fr !important;
      justify-items: center;
      gap: 0.75rem;
    }
  }
</style>
