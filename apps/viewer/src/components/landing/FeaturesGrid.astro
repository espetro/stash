---
// Features section — 6 cards, 3-column grid, Lucide icons, scroll-reveal

import {
  FaQrcode,
  FaRegHandPointer,
  FaToggleOff,
  FaTag,
  FaLock,
  FaLink,
} from "react-icons/fa6";
import FeatureCard from "./FeatureCard.astro";
import { t, type Lang } from "@/i18n";

interface Props {
  lang: Lang;
}
const { lang } = Astro.props;

const features = [
  {
    icon: FaLink,
    labelKey: "features.sharing.label",
    titleKey: "features.sharing.title",
    descriptionKey: "features.sharing.description",
  },
  {
    icon: FaLock,
    labelKey: "features.privacy.label",
    titleKey: "features.privacy.title",
    descriptionKey: "features.privacy.description",
  },
  {
    icon: FaRegHandPointer,
    labelKey: "features.workflow.label",
    titleKey: "features.workflow.title",
    descriptionKey: "features.workflow.description",
  },
  {
    icon: FaToggleOff,
    labelKey: "features.reliability.label",
    titleKey: "features.reliability.title",
    descriptionKey: "features.reliability.description",
  },
  {
    icon: FaTag,
    labelKey: "features.organization.label",
    titleKey: "features.organization.title",
    descriptionKey: "features.organization.description",
  },
  {
    icon: FaQrcode,
    labelKey: "features.mobile.label",
    titleKey: "features.mobile.title",
    descriptionKey: "features.mobile.description",
  },
];
---

<section
  class="bg-background py-20 px-6 border-t border-border lg:py-28 lg:px-8"
  id="features"
>
  <div class="max-w-7xl mx-auto">
    <header class="text-center mb-12 lg:mb-14">
      <h2 class="text-3xl font-semibold text-foreground tracking-tight m-0">
        {t("features.title", undefined, lang)}
      </h2>
    </header>

    <div class="grid grid-cols-1 gap-5 sm:grid-cols-2 lg:grid-cols-3 lg:gap-6">
      {
        features.map((feature) => (
          <FeatureCard
            icon={feature.icon}
            label={t(feature.labelKey, undefined, lang)}
            title={t(feature.titleKey, undefined, lang)}
            description={t(feature.descriptionKey, undefined, lang)}
          />
        ))
      }
    </div>
  </div>
</section>

<script>
  const observer = new IntersectionObserver(
    (entries) => {
      entries.forEach((entry) => {
        if (entry.isIntersecting) {
          entry.target.classList.add("revealed");
          observer.unobserve(entry.target);
        }
      });
    },
    { threshold: 0.1 },
  );

  document.querySelectorAll(".feature-card").forEach((card, i) => {
    (card as HTMLElement).style.transitionDelay = `${i * 60}ms`;
    observer.observe(card);
  });
</script>
