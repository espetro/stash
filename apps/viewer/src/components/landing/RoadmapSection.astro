---
// Roadmap section with compact grid
// Displays shipped features, upcoming items, and suggest CTA

import RoadmapCell from "./RoadmapCell.astro";
import { t, type Lang } from "@/i18n";

interface Props {
  lang: Lang;
}
const { lang } = Astro.props;

// Done items (shipped features)
const doneItems = [
  "roadmap.done.aiFirst",
  "roadmap.done.selectAnyTab",
  "roadmap.done.expiration",
  "roadmap.done.shareLink",
  "roadmap.done.theme",
  "roadmap.done.browsers",
  "roadmap.done.review",
];

// Upcoming items
const upcomingItems = ["roadmap.upcoming.languages", "roadmap.upcoming.safari"];

// Suggest link
const suggestHref = "https://github.com/espetro/stash/issues";
---

<section
  class="roadmap-section py-16 px-6 bg-background lg:py-20 lg:px-8"
  id="roadmap"
>
  <div class="roadmap-container max-w-[56rem] mx-auto text-center">
    <!-- Section header -->
    <h2
      class="section-headline text-foreground text-[1.75rem] font-bold tracking-[-0.025em] m-0 mb-1 lg:text-2xl"
    >
      {t("roadmap.title", undefined, lang)}
    </h2>
    <p
      class="section-subheadline text-muted-foreground text-base m-0 mb-10 lg:text-[1.0625rem] lg:mb-12"
    >
      {t("roadmap.subtitle", undefined, lang)}
    </p>

    <!-- Compact grid -->
    <div
      class="roadmap-grid grid grid-cols-2 gap-3 mb-8 sm:grid-cols-3 lg:grid-cols-5 lg:gap-4"
    >
      {
        doneItems.map((key) => (
          <RoadmapCell status="done" label={t(key, undefined, lang)} />
        ))
      }
      {
        upcomingItems.map((key) => (
          <RoadmapCell status="upcoming" label={t(key, undefined, lang)} />
        ))
      }
      <RoadmapCell
        status="suggest"
        label={t("roadmap.suggest", undefined, lang)}
        href={suggestHref}
      />
    </div>

    <!-- Legend -->
    <div class="legend flex items-center justify-center gap-6 flex-wrap">
      <span class="legend-item flex items-center gap-1">
        <span class="legend-badge text-xs">✓</span>
        <span class="legend-text text-[0.8125rem] text-muted-foreground"
          >{t("roadmap.legend.shipped", undefined, lang)}</span
        >
      </span>
      <span class="legend-item flex items-center gap-1">
        <span class="legend-badge text-xs">🕐</span>
        <span class="legend-text text-[0.8125rem] text-muted-foreground"
          >{t("roadmap.legend.comingSoon", undefined, lang)}</span
        >
      </span>
    </div>
  </div>
</section>

<style>
  /* No additional styles needed — all layout/spacing handled by Tailwind */
</style>
