---
import { LocaleProvider } from "@/components/LocaleProvider";
import { validateViewerOrigin } from "@stash/shared";

interface Props {
  title: string;
}
const { title } = Astro.props;
const posthogKey = import.meta.env.VITE_PUBLIC_POSTHOG_KEY;
const posthogHost = import.meta.env.VITE_PUBLIC_POSTHOG_HOST ?? 'https://eu.posthog.com';
// F12: the daemon-embedded build makes zero network requests, so PostHog
// and Google Fonts are compiled out of the loopback shell.
const embedded = Boolean(import.meta.env.VITE_EMBEDDED_VIEWER);

// Build-time origin, not Astro.url.origin — the latter resolves to the
// prerender/build server (localhost) for prerendered pages in production.
const rawViewerOrigin = import.meta.env.VITE_VIEWER_ORIGIN || 'https://stash.illo.fyi';
const viewerOrigin = validateViewerOrigin(rawViewerOrigin).success
  ? rawViewerOrigin
  : 'https://stash.illo.fyi';
---
<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <meta name="google-site-verification" content="dJbisPrLjFw4YbDPfmdhJtV27zFTjh8ZpOqXAFoTzAE" />
  <link rel="icon" type="image/png" href="/icon-128.png" sizes="128x128" />
  <link rel="icon" type="image/png" href="/icon-48.png" sizes="48x48" />
  <link rel="apple-touch-icon" href="/icon-128.png" />
  <title>{title}</title>
  {/* AI agent consumption — alternate representations of this stash page.
      SSR emits a stable href that omits the payload (fragments never reach
      the server); the useDecodeShareUrl hook fills in `p=<encoded>` client-side
      once the fragment is decoded. */}
  {(Astro.url.pathname === '/s' || Astro.url.pathname === '/s/' || Astro.url.pathname.startsWith('/s?')) && (
    <>
      <link rel="alternate" type="application/json" href={viewerOrigin + '/s?p=&format=json'} title="Stash as JSON" />
      <link rel="alternate" type="text/markdown" href={viewerOrigin + '/s?p=&format=md'} title="Stash as Markdown" />
    </>
  )}
  {(Astro.url.pathname === '/stashes' || Astro.url.pathname === '/stashes/') && (
    <>
      <link rel="alternate" type="application/json" href={viewerOrigin + '/stashes/?agent=json'} title="Stashes as JSON" />
      <link rel="alternate" type="text/markdown" href={viewerOrigin + '/stashes/?agent=markdown'} title="Stashes as Markdown" />
    </>
  )}
  {!embedded && posthogKey && posthogHost && (
    <script is:inline define:vars={{ posthogKey, posthogHost }}>
      (function() {
        var script = document.createElement('script');
        script.async = true;
        script.src = posthogHost + '/array.js';
        script.onload = function() {
          if (window.posthog && typeof window.posthog.init === 'function') {
            window.posthog.init(posthogKey, {
              api_host: posthogHost,
              persistence: 'memory',
              disable_cookie: true,
              autocapture: true,
              capture_pageview: true,
            });
          }
        };
        document.head.appendChild(script);
      })();
    </script>
  )}
  {!embedded && <link rel="preconnect" href="https://fonts.googleapis.com">}
  {!embedded && <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>}
  {!embedded && <link href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700&display=swap" rel="stylesheet">}
  <script>
    import { initTheme } from '@stash/theme';
    initTheme(localStorage);
  </script>
  <style is:global>
    @import '@/styles/global.css';
    * { box-sizing: border-box; }
    body {
      margin: 0;
      font-family: var(--font-sans, 'Inter', system-ui, sans-serif);
    }
  </style>
</head>
<body>
  <LocaleProvider>
    <slot />
  </LocaleProvider>
</body>
</html>
